    },
    {
      "run_id": "checkpoint-repeated",
      "policy": "checkpoints",
      "scenario": "repeated-checkpoint-results",
      "events": [
        {"phase": "triage", "tool": "context", "returned_memory_keys": ["memory:deploy-dokploy"], "served_chars": 80, "applied_criterion_keys": ["criterion:use-dokploy"]},
        {"phase": "deployment", "tool": "recall", "returned_memory_keys": ["memory:release-window"], "served_chars": 100, "applied_criterion_keys": []},
        {"phase": "decision", "tool": "other", "returned_memory_keys": [], "served_chars": 0, "applied_criterion_keys": ["criterion:use-dokploy", "criterion:respect-release-window"]}
