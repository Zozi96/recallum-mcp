        {"phase": "decision", "tool": "other", "returned_memory_keys": [], "served_chars": 0, "applied_criterion_keys": ["criterion:use-dokploy", "criterion:respect-release-window"]}
      ]
    },
    {
      "run_id": "checkpoint-session-rotation",
      "policy": "checkpoints",
      "scenario": "session-rotation-pivot",
      "events": [
        {"phase": "triage", "tool": "context", "returned_memory_keys": ["memory:api-auth"], "served_chars": 60, "applied_criterion_keys": []},
        {"phase": "session-rotation", "tool": "recall", "returned_memory_keys": ["memory:session-rotation-ttl"], "served_chars": 120, "applied_criterion_keys": []},
