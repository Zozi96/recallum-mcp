{
  "version": "1",
  "runs": [
    {
      "run_id": "baseline-session-rotation",
      "policy": "baseline",
      "scenario": "session-rotation-pivot",
      "events": [
        {"phase": "triage", "tool": "context", "returned_memory_keys": ["memory:api-auth"], "served_chars": 60, "applied_criterion_keys": []},
        {"phase": "session-rotation", "tool": "other", "returned_memory_keys": [], "served_chars": 0, "applied_criterion_keys": []},
        {"phase": "decision", "tool": "other", "returned_memory_keys": [], "served_chars": 0, "applied_criterion_keys": []}
      ]
    },
    {
      "run_id": "baseline-covered",
      "policy": "baseline",
      "scenario": "covered-by-initial-context",
      "events": [
        {"phase": "triage", "tool": "context", "returned_memory_keys": ["memory:api-auth"], "served_chars": 60, "applied_criterion_keys": []},
        {"phase": "implementation", "tool": "recall", "returned_memory_keys": ["memory:api-auth"], "served_chars": 40, "applied_criterion_keys": []},
        {"phase": "decision", "tool": "other", "returned_memory_keys": [], "served_chars": 0, "applied_criterion_keys": ["criterion:use-hashed-keys"]}
      ]
    },
    {
      "run_id": "baseline-repeated",
