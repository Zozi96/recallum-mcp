# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Agent worktrees (scratch, never commit)
.claude/worktrees/

# graphify: machine-local / regenerable (keep graph.json, GRAPH_REPORT.md, graph.html, manifest.json, cost.json, labels)
# .graphify_* covers interpreter/root pointers, learning state, and crash-leftover
# intermediates (.graphify_detect/extract/ast/semantic/analysis/cached/chunk files);
# labels are the one dotfile that must stay tracked (community names for queries).
graphify-out/.graphify_*
!graphify-out/.graphify_labels.json
graphify-out/.needs_update
graphify-out/cache/
graphify-out/.vocab.txt
graphify-out/memory/
graphify-out/reflections/
# dated backups graphify writes on rebuild; they duplicate the tracked outputs
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
